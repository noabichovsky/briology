# Environment variables for Briology.
# In production these go in: Webflow Cloud → environment → Environment variables.
# Locally, copy relevant values into .env.local (which is git-ignored).

# The mount path Webflow Cloud serves the app under (e.g. /briology).
# Leave empty for local development.
NEXT_PUBLIC_BASE_PATH=/briology

# Comma-separated Brio admin emails. Seeded as admins on first login.
ADMIN_EMAILS=someone@brioid.com,another@brioid.com

# Secret (32+ random chars) used to sign session tokens. REQUIRED in production.
AUTH_SECRET=replace-with-a-long-random-string

# Email provider for magic links (Resend). If unset, links are logged (dev only).
EMAIL_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Briology <hello@yourdomain.com>

# Anthropic Messages API key for the Claude-powered agent (Step 5).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
